# LLM Configuration
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Vector Database
VECTOR_DB_PATH=data/vector_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Sandbox Configuration (SANDBOX_TYPE: subprocess or docker)
SANDBOX_TYPE=subprocess
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# Tool Registry
TOOL_DIRECTORY=tools
TESTS_DIRECTORY=tests/generated
AUTO_APPROVE_TOOLS=false
HOT_RELOAD=true
# Seconds between scheduled regression runs; 0 disables
REGRESSION_INTERVAL_SECONDS=0

# Reuse thresholds
REUSE_SIMILARITY_THRESHOLD=0.75
REUSE_HIGH_CONFIDENCE=0.85

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/orchestrator.log
